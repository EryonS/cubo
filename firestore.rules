rules_version = '2';
// Cubo Blocks cloud save: one document per player, readable and writable only by that player.
// profile, settings and bests are JSON text (see src/platform/cloud-doc.ts).
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'profile', 'settings', 'bests', 'lang', 'updatedAt'])
        && request.resource.data.v is int
        && request.resource.data.updatedAt is int
        && request.resource.data.profile is string && request.resource.data.profile.size() < 500000
        && request.resource.data.settings is string
        && request.resource.data.bests is string
        && request.resource.data.lang in ['auto', 'fr', 'en'];
    }
  }
}
